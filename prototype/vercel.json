{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
{
  "buildCommand": "npm run build",
  "devCommand": "npm run start",
  "framework": "node",
  "installCommand": "npm install",
  "outputDirectory": "dist"
}