{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/clientes",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/clientes/",
      "destination": "/",
      "permanent": true
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
